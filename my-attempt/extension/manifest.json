{
  "manifest_version": 3,
  "name": "EdgeBridge",
  "version": "2.0.0",
  "description": "Edge 内嵌常驻浏览器桥：native messaging + chrome.debugger，零 TCP 端口、零授权弹窗。Agent 经 Unix socket 即可列标签页/执行 JS/截图/真实键鼠输入。",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VonFrey Bridge"
  },
  "key": ""
}
